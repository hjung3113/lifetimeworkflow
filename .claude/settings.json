{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$(command -v node || echo /opt/node22/bin/node)\" \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/gsd-check-update.js"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/gsd-session-state.sh"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR\"/tools/bootstrap/install.sh"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/memory-inject.sh"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash|Edit|Write|MultiEdit|Agent|Task",
        "hooks": [
          {
            "type": "command",
            "command": "\"$(command -v node || echo /opt/node22/bin/node)\" \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/gsd-context-monitor.js",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Read",
        "hooks": [
          {
            "type": "command",
            "command": "\"$(command -v node || echo /opt/node22/bin/node)\" \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/gsd-read-injection-scanner.js",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/gsd-phase-boundary.sh",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "[ -n \"$HARNESS_DEV_LIGHT\" ] && exit 0; python3 tools/harness_lint/workspace_check.py >/dev/null 2>&1 || exit 0; uv run python -m tools.hooks.format_on_write",
            "timeout": 30
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$(command -v node || echo /opt/node22/bin/node)\" \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/gsd-prompt-guard.js",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$(command -v node || echo /opt/node22/bin/node)\" \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/gsd-read-guard.js",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$(command -v node || echo /opt/node22/bin/node)\" \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/gsd-workflow-guard.js",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/gsd-validate-commit.sh",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "[ -n \"$HARNESS_DEV_LIGHT\" ] && exit 0; python3 tools/harness_lint/workspace_check.py >/dev/null 2>&1 || exit 0; uv run python -m tools.hooks.contract_guard",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Read|Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "[ -n \"$HARNESS_DEV_LIGHT\" ] && exit 0; python3 tools/harness_lint/workspace_check.py >/dev/null 2>&1 || exit 0; uv run python -m tools.hooks.secret_scan",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "[ -n \"$HARNESS_DEV_LIGHT\" ] && exit 0; python3 tools/harness_lint/workspace_check.py >/dev/null 2>&1 || exit 0; uv run python -m tools.hooks.commit_gate --from-hook",
            "timeout": 120
          }
        ]
      }
    ]
  },
  "skillOverrides": {
    "graphify": "name-only",
    "gsd:add-tests": "name-only",
    "gsd:audit-fix": "name-only",
    "gsd:autonomous": "name-only",
    "gsd:docs-update": "name-only",
    "gsd:explore": "name-only",
    "gsd:extract-learnings": "name-only",
    "gsd:fast": "name-only",
    "gsd:forensics": "name-only",
    "gsd:graphify": "name-only",
    "gsd:health": "name-only",
    "gsd:import": "name-only",
    "gsd:inbox": "name-only",
    "gsd:map-codebase": "name-only",
    "gsd:milestone-summary": "name-only",
    "gsd:mvp-phase": "name-only",
    "gsd:ns-context": "name-only",
    "gsd:ns-ideate": "name-only",
    "gsd:ns-manage": "name-only",
    "gsd:ns-project": "name-only",
    "gsd:ns-review": "name-only",
    "gsd:ns-workflow": "name-only",
    "gsd-context": "name-only",
    "gsd-ideate": "name-only",
    "gsd-manage": "name-only",
    "gsd-project": "name-only",
    "gsd-quality": "name-only",
    "gsd-workflow": "name-only",
    "gsd:plan-review-convergence": "name-only",
    "gsd:profile-user": "name-only",
    "gsd:review-backlog": "name-only",
    "gsd:stats": "name-only",
    "gsd:thread": "name-only",
    "gsd:ultraplan-phase": "name-only",
    "gsd:undo": "name-only",
    "gsd:workspace": "name-only",
    "gsd:workstreams": "name-only"
  }
}
