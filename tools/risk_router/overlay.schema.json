{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "minimum_lanes": {
      "type": "object",
      "additionalProperties": { "enum": ["FAST", "STANDARD", "STRICT", "CONTROLLED"] }
    },
    "additional_promotions": {
      "type": "object",
      "additionalProperties": { "enum": ["FAST", "STANDARD", "STRICT", "CONTROLLED"] }
    },
    "lanes": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "FAST": { "$ref": "#/$defs/laneAdditions" },
        "STANDARD": { "$ref": "#/$defs/laneAdditions" },
        "STRICT": { "$ref": "#/$defs/laneAdditions" },
        "CONTROLLED": { "$ref": "#/$defs/laneAdditions" }
      }
    }
  },
  "$defs": {
    "laneAdditions": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "required_artifacts_add": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
        "required_gates_add": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true }
      }
    }
  }
}
