{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lifetimeworkflow.local/harness/discipline-record.schema.json",
  "title": "Discipline record",
  "description": "One task-local claim that a required lane discipline was carried out. Tool-local, not constitution plane: it validates a task packet's own working record, not a cross-language wire format.",
  "type": "object",
  "additionalProperties": false,
  "required": ["discipline", "skill", "task_id", "satisfied_at_phase", "outputs"],
  "properties": {
    "discipline": { "type": "string", "minLength": 1 },
    "skill": { "type": "string", "minLength": 1 },
    "task_id": { "type": "string", "minLength": 1 },
    "satisfied_at_phase": { "$ref": "#/$defs/phase" },
    "outputs": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "notes": { "type": "string" },
    "panel": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reviews"],
      "properties": {
        "reviews": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["expert", "verdict", "finding_ids"],
            "properties": {
              "expert": { "type": "string", "minLength": 1 },
              "verdict": { "type": "string", "minLength": 1 },
              "finding_ids": {
                "type": "array",
                "items": { "type": "string", "minLength": 1 },
                "uniqueItems": true
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "phase": {
      "enum": [
        "INTAKE",
        "CLARIFY",
        "SPEC",
        "PLAN",
        "EXECUTE",
        "REVIEW",
        "VERIFY",
        "COMPLETE",
        "BLOCKED"
      ]
    }
  }
}
