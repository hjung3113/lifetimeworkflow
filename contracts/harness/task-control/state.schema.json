{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://harness.local/contracts/harness/task-control/state.schema.json",
  "title": "Task packet state contract",
  "description": "Current revision and repository context for a task packet.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "task_id",
    "phase",
    "revision",
    "baseline",
    "current_ref",
    "completed_items",
    "next_action",
    "blockers",
    "transition"
  ],
  "properties": {
    "task_id": { "$ref": "#/$defs/taskId" },
    "phase": { "$ref": "#/$defs/phase" },
    "revision": { "type": "integer", "minimum": 0 },
    "baseline": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repo_root", "commit"],
      "properties": {
        "repo_root": { "const": "." },
        "commit": { "$ref": "#/$defs/gitCommit" }
      }
    },
    "current_ref": { "$ref": "#/$defs/gitCommit" },
    "completed_items": {
      "type": "array",
      "items": { "$ref": "#/$defs/criterionId" },
      "uniqueItems": true
    },
    "next_action": { "type": "string", "minLength": 1 },
    "blockers": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "summary", "constraint_ids"],
        "properties": {
          "id": { "type": "string", "pattern": "^B-[0-9]{2,}$" },
          "summary": { "type": "string", "minLength": 1 },
          "constraint_ids": {
            "type": "array",
            "items": { "$ref": "#/$defs/constraintId" },
            "uniqueItems": true
          }
        }
      }
    },
    "transition": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["from", "to"],
          "properties": {
            "from": { "$ref": "#/$defs/phase" },
            "to": { "$ref": "#/$defs/phase" }
          }
        }
      ]
    },
    "evidence_integrity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["evidence_sha256", "run_hashes"],
      "properties": {
        "evidence_sha256": { "$ref": "#/$defs/sha256" },
        "run_hashes": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/sha256" }
        }
      }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "revision": { "const": 0 } }, "required": ["revision"] },
      "then": {
        "properties": {
          "phase": { "const": "INTAKE" },
          "transition": { "type": "null" }
        }
      },
      "else": {}
    }
  ],
  "$defs": {
    "taskId": { "type": "string", "pattern": "^T-[0-9]{14}-[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "phase": {
      "enum": [
        "INTAKE",
        "CLARIFY",
        "SPEC",
        "PLAN",
        "EXECUTE",
        "REVIEW",
        "VERIFY",
        "COMPLETE",
        "BLOCKED"
      ]
    },
    "criterionId": { "type": "string", "pattern": "^AC-[0-9]{2,}$" },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "constraintId": { "type": "string", "pattern": "^C-[0-9]{2,}$" },
    "gitCommit": {
      "type": "string",
      "oneOf": [
        { "pattern": "^[0-9a-f]{40}$" },
        { "pattern": "^[0-9a-f]{64}$" }
      ]
    }
  }
}
