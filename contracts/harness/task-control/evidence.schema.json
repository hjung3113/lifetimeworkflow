{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://harness.local/contracts/harness/task-control/evidence.schema.json",
  "title": "Task packet evidence contract",
  "description": "Index of immutable gate artifacts and criterion/finding trace references.",
  "type": "object",
  "additionalProperties": false,
  "required": ["task_id", "gate_runs", "findings"],
  "properties": {
    "task_id": { "$ref": "#/$defs/taskId" },
    "gate_runs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "gate",
          "status",
          "criterion_ids",
          "finding_ids",
          "artifact"
        ],
        "properties": {
          "id": { "$ref": "#/$defs/evidenceId" },
          "gate": { "type": "string", "minLength": 1 },
          "status": { "enum": ["PASSED", "FAILED", "SKIPPED", "BLOCKED"] },
          "criterion_ids": {
            "type": "array",
            "items": { "$ref": "#/$defs/criterionId" },
            "uniqueItems": true
          },
          "finding_ids": {
            "type": "array",
            "items": { "$ref": "#/$defs/findingId" },
            "uniqueItems": true
          },
          "argv": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 }
          },
          "exit_code": { "type": "integer" },
          "gate_version": { "type": "string", "minLength": 1 },
          "started_at": { "type": "string", "format": "date-time" },
          "ended_at": { "type": "string", "format": "date-time" },
          "source": { "enum": ["local", "ci"] },
          "human_approval_ref": {
            "type": "string",
            "pattern": "^approvals/[A-Za-z0-9_-]+\\.json$"
          },
          "artifact": { "$ref": "#/$defs/artifact" }
        }
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "summary", "constraint_ids", "severity", "disposition"],
        "properties": {
          "id": { "$ref": "#/$defs/findingId" },
          "summary": { "type": "string", "minLength": 1 },
          "constraint_ids": {
            "type": "array",
            "items": { "$ref": "#/$defs/constraintId" },
            "uniqueItems": true
          },
          "severity": { "enum": ["blocker", "major", "minor", "nit"] },
          "disposition": { "enum": ["open", "resolved", "accepted"] },
          "evidence_ref": { "$ref": "#/$defs/evidenceId" }
          ,"human_approval_ref": {
            "type": "string",
            "pattern": "^approvals/[A-Za-z0-9_-]+\\.json$"
          }
        },
        "allOf": [
          {
            "if": { "properties": { "disposition": { "enum": ["resolved", "accepted"] } }, "required": ["disposition"] },
            "then": { "required": ["evidence_ref"] }
          },
          {
            "if": { "properties": { "severity": { "const": "blocker" }, "disposition": { "const": "accepted" } }, "required": ["severity", "disposition"] },
            "then": { "required": ["human_approval_ref"] }
          }
        ]
      }
    },
    "redaction_report": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "refused_fields"],
      "properties": {
        "status": { "enum": ["CLEAR", "REFUSED"] },
        "refused_fields": {
          "type": "array",
          "items": { "enum": ["argv", "stdout", "stderr", "finding", "handoff"] },
          "uniqueItems": true
        }
      }
    }
  },
  "$defs": {
    "taskId": { "type": "string", "pattern": "^T-[0-9]{14}-[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "criterionId": { "type": "string", "pattern": "^AC-[0-9]{2,}$" },
    "constraintId": { "type": "string", "pattern": "^C-[0-9]{2,}$" },
    "evidenceId": { "type": "string", "pattern": "^E-[0-9]{2,}$" },
    "findingId": { "type": "string", "pattern": "^F-[0-9]{2,}$" },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "summary", "sha256"],
      "properties": {
        "path": {
          "type": "string",
          "pattern": "^artifacts/(?!(?:.*/)?\\.\\.(?:/|$)).+$"
        },
        "summary": { "type": "string", "minLength": 1 },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    }
  }
}
