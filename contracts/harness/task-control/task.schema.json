{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://harness.local/contracts/harness/task-control/task.schema.json",
  "title": "Task packet task contract",
  "description": "Human-ratified shape for immutable task intent and routing inputs.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "task_id",
    "goal",
    "non_goals",
    "risk_inputs",
    "lane",
    "acceptance_criteria",
    "constraints",
    "decision_refs"
  ],
  "properties": {
    "task_id": { "$ref": "#/$defs/taskId" },
    "goal": { "type": "string", "minLength": 1 },
    "non_goals": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "risk_inputs": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ambiguity",
        "change_scope",
        "data_security",
        "reversibility",
        "impact",
        "coordination",
        "context_pressure"
      ],
      "properties": {
        "ambiguity": { "$ref": "#/$defs/riskScore" },
        "change_scope": { "$ref": "#/$defs/riskScore" },
        "data_security": { "$ref": "#/$defs/riskScore" },
        "reversibility": { "$ref": "#/$defs/riskScore" },
        "impact": { "$ref": "#/$defs/riskScore" },
        "coordination": { "$ref": "#/$defs/riskScore" },
        "context_pressure": { "$ref": "#/$defs/riskScore" }
      }
    },
    "lane": { "$ref": "#/$defs/lane" },
    "acceptance_criteria": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "description"],
        "properties": {
          "id": { "$ref": "#/$defs/criterionId" },
          "description": { "type": "string", "minLength": 1 }
        }
      }
    },
    "constraints": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "description", "source_path", "source_sha256"],
        "properties": {
          "id": { "$ref": "#/$defs/constraintId" },
          "description": { "type": "string", "minLength": 1 },
          "source_path": { "$ref": "#/$defs/repoPath" },
          "source_sha256": { "$ref": "#/$defs/sha256" }
        }
      }
    },
    "decision_refs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "sha256"],
        "properties": {
          "path": { "type": "string", "pattern": "^docs/adr/ADR-[^/]+\\.md$" },
          "sha256": { "$ref": "#/$defs/sha256" }
        }
      },
      "uniqueItems": true
    }
  },
  "$defs": {
    "taskId": {
      "type": "string",
      "pattern": "^T-[0-9]{14}-[a-z0-9]+(?:-[a-z0-9]+)*$",
      "description": "Immutable T-prefixed UTC yyyymmddHHMMSS timestamp and kebab slug."
    },
    "lane": { "enum": ["FAST", "STANDARD", "STRICT", "CONTROLLED"] },
    "riskScore": { "type": "integer", "minimum": 0, "maximum": 3 },
    "criterionId": { "type": "string", "pattern": "^AC-[0-9]{2,}$" },
    "constraintId": { "type": "string", "pattern": "^C-[0-9]{2,}$" },
    "repoPath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
    },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
  }
}
