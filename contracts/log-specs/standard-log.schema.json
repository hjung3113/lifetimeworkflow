{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://harness.local/contracts/log-specs/standard-log.schema.json",
  "title": "standard-log TSV spec (SEED PLACEHOLDER companion schema)",
  "description": "Draft 2020-12 companion schema for standard-log.spec.yaml. Validates the spec structure (format block + columns array) while allowing TBD placeholder values. Seed/example — domain-confirmed values Out of Scope (CONTRACT-01).",
  "type": "object",
  "required": ["id", "format", "columns"],
  "additionalProperties": true,
  "properties": {
    "id": { "type": "string" },
    "description": { "type": "string" },
    "owner": { "type": "string" },
    "version": { "type": "string" },
    "format": {
      "type": "object",
      "required": ["type", "encoding", "newline"],
      "additionalProperties": true,
      "properties": {
        "type": { "type": "string" },
        "encoding": { "type": "string" },
        "newline": { "type": "string" },
        "null_representation": { "type": "string" }
      }
    },
    "columns": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "type", "nullable"],
        "additionalProperties": true,
        "properties": {
          "name": { "type": "string" },
          "type": { "type": "string" },
          "nullable": { "type": "boolean" }
        }
      }
    },
    "carryover": { "type": "object" },
    "change_policy": { "type": "object" }
  }
}
