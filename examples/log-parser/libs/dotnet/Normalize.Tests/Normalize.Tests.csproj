<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Corpus parity tests for the §4-5 .NET core. xunit.v3 3.2.2 (Microsoft.Testing.Platform
    built in, matches .NET 10). Loads the SAME libs/normalize-fixtures corpus as the Python suite.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" Version="3.2.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../Normalize/Normalize.csproj" />
  </ItemGroup>

</Project>
